# API ortam degiskenleri ORNEGI. Gercek degerleri BU dosyaya yazmayin; sirlari kendi sir yoneticinizde tutun (docs/yedekleme.md: anahtar yedegi).
# Uretim: NODE_ENV=production. Asagidaki ALERT_ALLOW_* gelistirme bayraklari uretimde TANIMLANMAMALIDIR (tanimlanirsa API baslamaz).
NODE_ENV=production

DATABASE_URL=postgres://sysmon:<PAROLA>@127.0.0.1:5432/sysmon
# 32 bayt, base64: openssl rand -base64 32  (credential sifreleme; KAYBEDILIRSE yeniden kayit gerekir)
CREDENTIAL_KEY=<32-bayt-base64>
# 32 bayt, base64: openssl rand -base64 32  (bildirim kanali sirlari; KAYBEDILIRSE kanallar cozulemez; DB yedeginden AYRI yedekleyin; donusturme desteklenmez)
CHANNEL_KEY=<32-bayt-base64>

HOST=127.0.0.1
PORT=8443
# Ters proxy arkasinda: yalniz guvenilen proxy IP/CIDR LISTESI ("true" ve sayisal atlama sayisi REDDEDILIR)
TRUST_PROXY=127.0.0.1
# Panelin koken(ler)i (CSRF Origin denetimi)
ALLOWED_ORIGINS=https://izleme.example.com
# TLS proxy'de sonlaniyorsa TLS_CERT/TLS_KEY TANIMLAMAYIN; API dogrudan HTTPS dinleyecekse ikisini de verin.
# TLS_CERT=/etc/ssl/sysmon/fullchain.pem
# TLS_KEY=/etc/ssl/sysmon/privkey.pem

LOG_LEVEL=info
MIGRATE=1
SAMPLE_INTERVAL_SECONDS=5
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# ---- YALNIZ GELISTIRME/TEST (uretimde ASLA): ----
# ALERT_ALLOW_PRIVATE_TARGETS=1
# ALERT_ALLOW_INSECURE_WEBHOOK=1
