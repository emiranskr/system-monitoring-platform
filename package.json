{
  "name": "system-monitoring-platform",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && node --test \"scripts/*.test.mjs\"",
    "lint": "pnpm -r --if-present lint",
    "test:security": "pnpm --filter @sysmon/api test:security && pnpm --filter @sysmon/db test && node --test \"scripts/*.test.mjs\"",
    "drill:backup": "node scripts/backup-restore-drill.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:live": "node scripts/demo.mjs --live",
    "license-scan": "node scripts/license-scan.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
